# --- Server ---
PORT=4000
# NODE_ENV is set by the npm scripts (dev / start / test / build). Only set it here if you run
# `node server/src/index.js` directly; a value here must never be "development" for a build.
# NODE_ENV=production
# SQLite file and upload folder (relative paths resolve from the repo root).
DB_PATH=./data/portfolio.db
UPLOAD_DIR=./uploads
# 32+ random chars. Signs admin sessions and salts analytics hashes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SERVER_SECRET=

# --- Admin account (created/updated by `npm run seed`; password must be 10+ chars) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Owner ---
GITHUB_USERNAME=DHULIPALLA-JITENDRA-VARMA
GITHUB_URL=https://github.com/DHULIPALLA-JITENDRA-VARMA
# Optional: raises the GitHub API limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=
LINKEDIN_URL=https://www.linkedin.com/in/jitendra-varma-dhulipalla-66b796304/

# --- Web ---
# Origin of the Vite dev server (CORS allow-list).
CLIENT_ORIGIN=http://localhost:5173
# Optional: public base URL used in sitemap.xml and Open Graph tags (defaults to the request host).
SITE_URL=

# --- Optional: email a copy of each contact message ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TO=
